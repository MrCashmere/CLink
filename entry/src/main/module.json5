{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": ["phone", "tablet", "2in1"],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 应用级沉浸式系统材质开关（API 26.0.0 起生效，仅 entry 模块有效）。
    // enable 模式下 systemMaterial 的材质样式优先级高于组件自身的背景色、模糊、阴影与边框。
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET",
        "reason": "$string:permission_internet",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO",
        "reason": "$string:permission_network_info",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.GET_WIFI_INFO",
        "reason": "$string:permission_wifi",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },

      {
        "name": "ohos.permission.SET_WIFI_INFO",
        "reason": "$string:permission_wifi",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.ACCESS_BLUETOOTH",
        "reason": "$string:permission_bluetooth",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.LOCATION",
        "reason": "$string:permission_location",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.APPROXIMATELY_LOCATION",
        "reason": "$string:permission_location",
        "usedScene": { "abilities": ["EntryAbility"], "when": "inuse" }
      },
      {
        "name": "ohos.permission.GET_BUNDLE_INFO",
        "reason": "$string:permission_bundle"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING",
        "reason": "$string:permission_keep_background_running"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:ability_desc",
        "icon": "$media:app_icon",
        "label": "$string:app_name",
        "startWindowIcon": "$media:app_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "backgroundModes": ["dataTransfer"],
        "skills": [
          {
            "entities": ["entity.system.home"],
            "actions": ["action.system.home"]
          },
          {
            "actions": ["ohos.want.action.sendData"],
            "uris": [
              { "scheme": "file", "utd": "general.text", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.plain-text", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.html", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.xml", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.json", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.pdf", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "com.adobe.pdf", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "openharmony.app", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "openharmony.hap", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.image", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.png", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.jpeg", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.gif", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.webp", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.bmp", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.svg", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.heic", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.heif", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.avif", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.video", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.mpeg", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.mp4", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.mov", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.avi", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.webm", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.audio", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.mp3", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.wav", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.flac", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.aac", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.archive", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.zip", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.rar", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.7z", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.tar", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.gz", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.docx", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.xlsx", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.pptx", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.doc", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.xls", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.ppt", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.vnd.ms-word", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.vnd.ms-excel", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.vnd.ms-powerpoint", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.vnd.openxmlformats-officedocument.wordprocessingml", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.vnd.openxmlformats-officedocument.spreadsheetml", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.vnd.openxmlformats-officedocument.presentationml", "maxFileSupported": 100 },
              { "scheme": "file", "utd": "general.file", "maxFileSupported": 100 }
            ]
          }
        ]
      }
    ]
  }
}
